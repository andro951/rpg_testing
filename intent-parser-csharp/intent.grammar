operation_list : item*
item : group | atom
group : LPAREN item* RPAREN | LBRACE item* RBRACE | LBRACKET item* RBRACKET
atom : STRING | NUMBER | WORD | DELIMITER | PATH_SEPARATOR | SEP_COMMA | SEMICOLON | NEWLINE
STRING : /"(?:[^"\\\r\n]|\\.)*"/ (KEEP)
NUMBER : /-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/ (KEEP)
DELIMITER : /=>|->|:|=/ (KEEP)
WORD : /(?:(?!->)[^\s"(){}\[\],;:=\/\.>])+/ (KEEP)
PATH_SEPARATOR : /\.|\// (KEEP)
LPAREN : /\(/ (KEEP)
RPAREN : /\)/ (KEEP)
LBRACE : /\{/ (KEEP)
RBRACE : /\}/ (KEEP)
LBRACKET : /\[/ (KEEP)
RBRACKET : /\]/ (KEEP)
SEP_COMMA : /,/ (KEEP)
SEMICOLON : /;/ (KEEP)
HORIZONTAL_SPACE : /[^\S\r\n\u2028\u2029]+/ (IGNORE)
NEWLINE : /\r\n|[\r\n\u2028\u2029]/ (KEEP)
