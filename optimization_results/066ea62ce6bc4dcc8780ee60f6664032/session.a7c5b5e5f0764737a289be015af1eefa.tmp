    },
    "placeholder_rules": {
      "syntax": "${label}",
      "minimum_occurrences": 1,
      "occurrence_scope": "across_both_templates",
      "allow_repeated_labels": true,
      "unknown_labels": "invalid_candidate",
      "substitution": "literal_single_pass_no_expression_evaluation"
    },
    "generator_response": {
      "format": "plain_text_two_sections",
      "required_headings_in_order": [
        "SYSTEM_MESSAGE:",
        "USER_MESSAGE:"
      ],
      "heading_rules": "exact_standalone_lines_once_each_no_preamble_or_nested_heading_lines",
      "message_text": "literal_real_line_breaks_no_json_escaping",
      "invalid_response": "save_raw_and_feedback_count_attempt"
    },
    "scope_plan": {
      "reference_component": "value_patch_formatting",
      "reference_catalog": "optimization/sharing.json",
      "layers": [
        "origin_pass_gate",
        "all_matching_task_type"
      ],
      "full_template_bindings": "optimization.templates.bindings; immutable source, presentation and operation requirements; original prior steps preserved",
      "models": "all_available_runnable_models_on_current_execution_machine_frozen_at_session_start",
      "local_completion": "qualifies_for_layer_completion_top_three_incumbent_and_perfect_score_stop",
      "other_machine_models": "pending_later_evaluation_not_required_for_local_completion",
      "cross_machine_resume": "evaluate_missing_observations_for_saved_candidates_without_regeneration_or_new_attempt",
      "comparison_cohorts": "same_tests_and_model_set_only",
      "repetitions": "full_existing_configured_count",
      "rejected_tests": "never_run",
      "duplicate_rendered_requests": "record_alias_coverage_count_unique_observations_once",
      "task_type": "Database Copy",
      "expansion_rule": "A pass on every configured origin repetition for the selected starting-case model opens all matching task-type tests on all runnable current-host models. No intermediate layers.",
      "membership": "Derived from reviewed, enabled current definitions at session creation; no draft is runnable."
    },
    "generation_defaults": {
      "maximum_attempts": 20,
      "temperature_minimum": 0.5,
      "temperature_maximum": 0.9,
      "temperature_distribution": "uniform_each_generation_request",
      "seed": "fresh_random_uint32_each_generation_request",
      "generator_reasoning": false,
      "test_reasoning": "always_off_not_configurable"
    },
    "ranking": {
      "score": "pooled_pass_observations_over_all_scored_observations",
      "individual_model_regressions": "allowed_if_total_improves",
      "top_three": "unique_candidates_complete_on_entire_test_scope_for_current_machine_model_cohort",
      "ties": "proposed_earlier_candidate_retained"
    },
    "stopping": {
      "maximum_attempts": true,
      "consecutive_failures": false,
      "new_best_without_perfection": false,
      "perfect_candidate": "100_percent_on_every_test_and_repetition_for_every_model_in_nonempty_current_machine_cohort",
      "explicit_pause_stop": true
    },
    "history": {
      "save": "all_attempts_and_evidence_regardless_of_outcome",
      "feed": "retained_all_attempts_plus_complete_top_three_templates_and_at_least_per_model_per_test_summaries",
      "prune": "prompt_history_only_earliest_rejected_layer_then_lowest_same_layer_score",
      "protected": [
        "required_labels",
        "immutable_contract",
        "current_task_baseline",
        "top_three_templates_and_required_summaries"
      ],
      "protected_packet_exceeds_context": "pause_for_configuration_change"
    },
    "prompt_files": {
      "system": "docs/prompt-optimization/optimizer-system.txt",
      "user": "docs/prompt-optimization/optimizer-user-template.txt",
      "task_definition": "database-task.txt"
    }
  },
