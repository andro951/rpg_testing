                },
                "uniqueItems": true
              },
              "archived_locations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "locations",
              "archived_locations"
            ],
            "additionalProperties": false
          },
          "expected_state": {
            "locations": [
              "town-c",
              "town-a",
              "town-b"
            ],
            "archived_locations": [
              "town-a"
            ]
          },
