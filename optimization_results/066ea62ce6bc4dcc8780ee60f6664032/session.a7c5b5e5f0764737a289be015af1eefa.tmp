                "current_state": "{\n  \"items\": [\n    {\n      \"item_id\": \"item-42\",\n      \"name\": \"Sword\",\n      \"count\": 3\n    },\n    {\n      \"item_id\": \"item-17\",\n      \"name\": \"Sword\",\n      \"count\": 8\n    },\n    {\n      \"item_id\": \"item-83\",\n      \"name\": \"Potion\",\n      \"count\": 2\n    },\n    {\n      \"item_id\": \"item-26\",\n      \"name\": \"Shield\",\n      \"count\": 6\n    }\n  ],\n  \"storage\": []\n}",
