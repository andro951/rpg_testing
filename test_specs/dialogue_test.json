{
  "schema_version": 2,
  "id": "dialogue_test",
  "name": "Dialogue test",
  "description": "Open-ended dialogue generation using a locally supplied prompt.",
  "workflow": "steps",
  "repetitions": 3,
  "timeout_seconds": 60,
  "state_presentation": "raw_json",
  "instructions": "Follow the user's prompt.",
  "source": {
    "initial_state": {},
    "new_information": ""
  },
  "variants": [
    {
      "id": "dialogue_response",
      "name": "Dialogue response",
      "cache": "default",
      "prompt_style": "direct_text_v1",
      "steps": [
        {
          "id": "response",
          "type": "generate",
          "prompt": "{put prompt here}",
          "output": {
            "type": "text"
          },
          "sampling": {
            "temperature": 0.9,
            "top_p": 1,
            "seed": 42
          }
        }
      ],
      "result": {
        "step": "response",
        "representation": "answers"
      }
    }
  ]
}
